# Copy to .env. Node-RED, broker and simulator read this file when started via npm.
PORT=1880
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# Browser uses WebSocket, not TCP port 1883.
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
# CHANGE to a unique classroom/group prefix; public topics are NOT private.
MQTT_PREFIX=ukara/aiot/hoc3/vibration
DEVICE_ID=esp32-01
# Optional offline broker helper only; unused in the default HiveMQ demo.
BROKER_BIND=127.0.0.1
MQTT_WS_PORT=9001
ALARM_WINDOWS=3
RECOVERY_WINDOWS=3
COOLDOWN_MS=60000
STALE_MS=10000
# No messages are sent by default. Enable only after configuring YOUR recipients.
NOTIFICATIONS_ENABLED=false
NOTIFY_SIMULATION=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
