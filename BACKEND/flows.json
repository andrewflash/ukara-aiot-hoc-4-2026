    "x": 270,
    "y": 200,
    "wires": [
      [
        "event"
      ]
    ],
    "func": "try { const result = global.get('workshop').ingest(msg.payload, msg.topic, Date.now(), msg.retain === true); if (!result.accepted) return null; msg.payload = result; return msg; } catch(e) { node.error(e.message, msg); return null; }",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
