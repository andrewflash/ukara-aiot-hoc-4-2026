  {
    "id": "nrui-tick",
    "type": "inject",
    "z": "nrui-tab",
    "name": "Baca SQLite setiap 2 detik",
    "x": 190,
    "y": 100,
    "wires": [
      [
        "nrui-snapshot"
      ]
    ],
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "2",
    "once": true,
    "onceDelay": 1,
    "payload": "",
    "payloadType": "date"
  },
  {
    "id": "nrui-snapshot",
    "type": "function",
    "z": "nrui-tab",
    "name": "Snapshot perangkat dari DEVICE_ID",
    "x": 490,
    "y": 100,
    "wires": [
      [
        "nrui-status"
      ],
      [
        "nrui-score"
      ],
      [
        "nrui-label"
      ],
      [
        "nrui-source"
      ],
      [
        "nrui-chart"
      ],
      [
        "nrui-history"
      ],
      [
        "nrui-events"
      ]
    ],
    "outputs": 7,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "func": "const svc = global.get('workshop');\nconst device = env.get('DEVICE_ID') || 'esp32-01';\nconst rows = svc.query('telemetry', device, 40);\nconst latest = rows[0];\nconst state = svc.devices().find(d => d.device === device);\nconst status = !latest ? 'BELUM ADA DATA' : state?.stale ? 'DATA TERLAMBAT — status terbaru tidak diketahui' : latest.status;\nconst events = svc.query('events', device, 20).map(e => ({Waktu:new Date(e.received_at).toLocaleString('id-ID'),Event:e.kind,Pengiriman:e.deliveries.map(d => d.channel+': '+d.status).join(', ') || 'Belum ada hasil pengiriman'}));\nreturn [\n {payload:device+' | '+status+' | Alarm: '+(state?.alarm_active ? 'AKTIF' : 'tidak aktif')},\n {payload:latest ? 'Skor '+latest.anomaly.toFixed(3)+' / Ambang '+latest.threshold : '—'},\n {payload:latest ? latest.label+' | Confidence '+(latest.confidence*100).toFixed(1)+'%' : '—'},\n {payload:latest ? (latest.simulated ? 'SIMULASI MQTT' : 'PERANGKAT / PAYLOAD NON-SIMULASI')+' | Diterima '+new Date(latest.received_at).toLocaleString('id-ID') : 'Jalankan simulator MQTT atau ESP32. Skor anomali bukan probabilitas kerusakan.'},\n {action:'replace',payload:rows.slice().reverse().flatMap(r => [{series:'Anomali',time:r.received_at,value:r.anomaly},{series:'Ambang',time:r.received_at,value:r.threshold}])},\n {payload:rows.slice(0,10).map(r => ({Waktu:new Date(r.received_at).toLocaleTimeString('id-ID'),Status:r.status,Label:r.label,Anomali:r.anomaly,Ambang:r.threshold,Confidence:(r.confidence*100).toFixed(1)+'%'}))},\n {payload:events}\n];"
  },
